# ---- Public (baked into the browser bundle at build time) ----
NEXT_PUBLIC_SITE_URL=https://codyfiesel.com
# Cody's Meta Pixel ID. Loads only after the visitor accepts marketing cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# Optional Google Tag Manager container (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Optional Calendly link; when set, CTAs show "Book a Call"
NEXT_PUBLIC_CALENDLY_URL=
# Where CCPA requests go. Defaults to the agent email in brand.js
NEXT_PUBLIC_PRIVACY_EMAIL=
# Set to "false" to hide the cookie banner (not recommended in California)
NEXT_PUBLIC_CONSENT_BANNER_ENABLED=true

# ---- Server only (never NEXT_PUBLIC_) ----
# Cody's own SimplyRETS app credentials (BAREIS feed)
SIMPLYRETS_API_KEY=
SIMPLYRETS_API_SECRET=

# Lead delivery. All optional and independent. Leads always log to stdout.
# Follow Up Boss: creates the lead via the Events API.
FUB_API_KEY=
FUB_SOURCE=codyfiesel.com
FUB_SYSTEM=
FUB_SYSTEM_KEY=
# Webhook (n8n / Zapier / Make) that emails or texts the lead to Cody.
LEAD_WEBHOOK_URL=
# Sent as X-Lead-Secret header so the receiver can reject spoofed posts.
LEAD_WEBHOOK_SECRET=
